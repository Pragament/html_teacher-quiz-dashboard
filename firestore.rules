rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSchoolAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/schoolAdmins/$(request.auth.uid));
    }

    function hasSectionRole(sectionData, role) {
      return signedIn()
        && request.auth.token.email is string
        && sectionData.members is list
        && sectionData.members.hasAny([{
          email: request.auth.token.email.lower(),
          role: role
        }]);
    }

    function canViewSection(sectionData) {
      return hasSectionRole(sectionData, 'admin') || hasSectionRole(sectionData, 'viewer');
    }

    function canAdminSection(sectionData) {
      return hasSectionRole(sectionData, 'admin');
    }

    function ownsClassroom(classroomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId))
        && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.creatorId == request.auth.uid;
    }

    function ownsQuestionBankList(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/qb_lists_v1/$(listId))
        && get(/databases/$(database)/documents/qb_lists_v1/$(listId)).data.ownerUid == request.auth.uid;
    }

    function sectionExists(sectionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classSections/$(sectionId))
        && canViewSection(get(/databases/$(database)/documents/classSections/$(sectionId)).data);
    }

    function hasValidQuestionBankList() {
      return !('questionBankListId' in request.resource.data)
        || ownsQuestionBankList(request.resource.data.questionBankListId);
    }

    function hasValidSection() {
      return !('sectionId' in request.resource.data)
        || sectionExists(request.resource.data.sectionId);
    }

    function canAdminClassroomSection(classroomData) {
      return signedIn()
        && classroomData.sectionId is string
        && exists(/databases/$(database)/documents/classSections/$(classroomData.sectionId))
        && canAdminSection(get(/databases/$(database)/documents/classSections/$(classroomData.sectionId)).data);
    }

    function canReviewSubmission(submissionData) {
      return ownsClassroom(submissionData.classroomId)
        || (
          signedIn()
          && submissionData.sectionId is string
          && exists(/databases/$(database)/documents/classSections/$(submissionData.sectionId))
          && canAdminSection(get(/databases/$(database)/documents/classSections/$(submissionData.sectionId)).data)
        );
    }

    function isAiReviewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'answers',
        'aiReviewUpdatedAt',
        'aiReviewUpdatedBy',
        'aiReviewUpdatedByEmail'
      ])
      && resource.data.answers is list
      && request.resource.data.answers is list
      && request.resource.data.answers.size() == resource.data.answers.size()
      && request.resource.data.aiReviewUpdatedAt is number
      && request.resource.data.aiReviewUpdatedBy == request.auth.uid
      && request.auth.token.email is string
      && request.resource.data.aiReviewUpdatedByEmail == request.auth.token.email;
    }

    match /classSections/{sectionId} {
      allow read: if canViewSection(resource.data);
      allow create: if isSchoolAdmin();
      allow update, delete: if isSchoolAdmin() || canAdminSection(resource.data);

      match /students/{studentId} {
        allow read: if exists(/databases/$(database)/documents/classSections/$(sectionId))
          && canViewSection(get(/databases/$(database)/documents/classSections/$(sectionId)).data);
        allow write: if isSchoolAdmin()
          || (
            exists(/databases/$(database)/documents/classSections/$(sectionId))
            && canAdminSection(get(/databases/$(database)/documents/classSections/$(sectionId)).data)
          );
      }
    }

    match /classrooms/{classroomId} {
      allow read: if signedIn()
        && (resource.data.creatorId == request.auth.uid || canAdminClassroomSection(resource.data));
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && hasValidQuestionBankList()
        && hasValidSection();
      allow update: if signedIn()
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == resource.data.creatorId
        && hasValidQuestionBankList()
        && hasValidSection();
      allow delete: if false;
    }

    match /qb_lists_v1/{listId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /qb_quiz_submissions_v1/{submissionId} {
      // Strongest option, if submissions include teacherUid:
      // allow read: if signedIn() && resource.data.teacherUid == request.auth.uid;

      // Works for classroom owners, and for section admins when submissions include sectionId.
      allow read: if canReviewSubmission(resource.data);

      allow update: if canReviewSubmission(resource.data) && isAiReviewUpdate();
      allow create, delete: if false;
    }
  }
}
