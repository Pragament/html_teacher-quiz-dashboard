rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsClassroom(classroomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classrooms/$(classroomId))
        && get(/databases/$(database)/documents/classrooms/$(classroomId)).data.creatorId == request.auth.uid;
    }

    match /classrooms/{classroomId} {
      allow read: if signedIn() && resource.data.creatorId == request.auth.uid;
      allow write: if false;
    }

    match /qb_quiz_submissions_v1/{submissionId} {
      // Strongest option, if submissions include teacherUid:
      // allow read: if signedIn() && resource.data.teacherUid == request.auth.uid;

      // Works when resource.data.classroomId is the actual classroom document id.
      allow read: if ownsClassroom(resource.data.classroomId);

      allow create, update, delete: if false;
    }
  }
}
